      "targets": [{"editorMode": "code", "expr": "kafka_consumergroup_lag{topic=\"$topic\",consumergroup=~\"event-(archive|billing|statistics)-consumer\"}", "legendFormat": "{{consumergroup}} / partition {{partition}}", "range": true, "refId": "A"}],
