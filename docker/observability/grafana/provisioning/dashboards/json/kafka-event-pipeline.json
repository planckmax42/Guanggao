      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 28},
      "id": 15,
      "targets": [
        {"editorMode": "code", "expr": "sum by (stage) (rate(ad_event_consumer_messages_total{result=\"success\"}[$__rate_interval]))", "legendFormat": "{{stage}} success", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum by (stage) (rate(ad_event_consumer_messages_total{result=~\"business_error|failure\"}[$__rate_interval]))", "legendFormat": "{{stage}} error", "range": true, "refId": "B"}
      ],
