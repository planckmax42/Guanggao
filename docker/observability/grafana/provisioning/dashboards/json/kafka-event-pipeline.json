      "targets": [{"editorMode": "code", "expr": "clamp_min(sum(rate(kafka_topic_partition_current_offset{topic=\"$topic\"}[$__rate_interval])), 0)", "legendFormat": "Produced", "range": true, "refId": "A"}],
