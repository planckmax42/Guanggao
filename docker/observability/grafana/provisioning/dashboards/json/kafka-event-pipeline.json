      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "ad-platform-prometheus"},
      "fieldConfig": {"defaults": {"decimals": 0, "min": 0, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 28},
